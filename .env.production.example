# Production environment for the Shaniena shop.
#
# Copy to the server as /var/www/shaniena/shared/.env — NOT into a release
# directory; releases symlink to it, which is how the file survives a deploy
# and a rollback. `chown www-data:www-data` and `chmod 600` it: it is the only
# place credentials live now (the source project had the database password in
# config/function.php and in four cron scripts, all of them in git).
#
# Every value marked CHANGE ME must be replaced before the first deploy.
# `php artisan shaniena:preflight` fails on the ones it can detect.

APP_NAME=Shaniena
APP_ENV=production
# php artisan key:generate --show   (generate ON the server; never reuse the
# local key — it decrypts every session cookie the site has ever issued)
APP_KEY=                                  # CHANGE ME
APP_DEBUG=false
APP_URL=https://shaniena.com              # CHANGE ME
APP_TIMEZONE=Asia/Kuala_Lumpur

APP_LOCALE=en
APP_FALLBACK_LOCALE=en
APP_MAINTENANCE_DRIVER=file

# Cost of a bcrypt round. 12 is ~250ms on the target box; raise only after
# measuring, because the login form waits on it.
BCRYPT_ROUNDS=12

# --- Logging --------------------------------------------------------------
# Daily files, kept a fortnight. `debug` would write every SQL binding, which
# on this app means customer addresses and gateway payloads on disk.
LOG_CHANNEL=stack
LOG_STACK=daily
LOG_DAILY_DAYS=14
LOG_LEVEL=warning
LOG_DEPRECATIONS_CHANNEL=null

# --- Database -------------------------------------------------------------
DB_CONNECTION=mysql
DB_HOST=127.0.0.1
DB_PORT=3306
DB_DATABASE=shaniena
DB_USERNAME=shaniena                      # CHANGE ME — not root
DB_PASSWORD=                              # CHANGE ME

# The old shop's database, read-only, used by the one-off import at cutover
# (`php artisan shaniena:import`). Leave blank once the cutover is done and
# the grant is revoked — nothing in the running app reads this connection.
SRC_DB_HOST=
SRC_DB_PORT=3306
SRC_DB_DATABASE=
SRC_DB_USERNAME=
SRC_DB_PASSWORD=

# --- Redis: sessions, cache and queue -------------------------------------
# Three separate logical databases, so `cache:clear` cannot sign every
# customer out and `queue:flush` cannot empty the cache.
REDIS_CLIENT=phpredis
REDIS_HOST=127.0.0.1
REDIS_PORT=6379
REDIS_PASSWORD=                           # CHANGE ME (requirepass in redis.conf)
REDIS_DB=0
REDIS_CACHE_DB=1
REDIS_QUEUE=default

SESSION_DRIVER=redis
SESSION_LIFETIME=120
SESSION_ENCRYPT=false
SESSION_PATH=/
SESSION_DOMAIN=.shaniena.com              # CHANGE ME — leading dot covers www
# The site is https-only; without this the session cookie is offered over
# plain http as well. Preflight fails if APP_URL is https and this is not true.
SESSION_SECURE_COOKIE=true
SESSION_HTTP_ONLY=true
# Gateways return the customer by a cross-site POST, and `strict` would drop
# the session on the way back — they would land at checkout signed out.
SESSION_SAME_SITE=lax

CACHE_STORE=redis
CACHE_PREFIX=shaniena_cache

QUEUE_CONNECTION=redis
QUEUE_FAILED_DRIVER=database-uuids

BROADCAST_CONNECTION=log
FILESYSTEM_DISK=local

# --- Inertia SSR ----------------------------------------------------------
# The node process supervised as shaniena-ssr. If it is down the storefront
# still serves, client-rendered — a ranking problem, not an outage.
INERTIA_SSR_ENABLED=true
INERTIA_SSR_URL=http://127.0.0.1:13714

# --- Mail -----------------------------------------------------------------
# Order confirmations, verification codes, password resets and ticket replies
# all go through this. `log` in production means the customer is never told
# their order was received; preflight fails on it.
MAIL_MAILER=smtp                          # CHANGE ME
MAIL_HOST=                                # CHANGE ME
MAIL_PORT=587
MAIL_USERNAME=                            # CHANGE ME
MAIL_PASSWORD=                            # CHANGE ME
MAIL_SCHEME=tls
MAIL_FROM_ADDRESS=orders@shaniena.com     # CHANGE ME — preflight rejects example.com
MAIL_FROM_NAME="${APP_NAME}"

# --- Shipping -------------------------------------------------------------
# The pickup address every courier is given. DHL and J&T credentials live in
# their settings tables, edited in the admin console, not here.
SHIPPER_NAME="ROZZ BEAUTY LEGACY"
SHIPPER_CONTACT=Admin
SHIPPER_ADDRESS_1="B-G-48, SAVANNA LIFESTYLE RETAIL"
SHIPPER_ADDRESS_2="Jalan Southville 2, Southville City"
SHIPPER_CITY=Dengkil
SHIPPER_STATE=Selangor
SHIPPER_POSTCODE=43800
SHIPPER_PHONE=60389123807
SHIPPER_EMAIL=orders@shaniena.com         # CHANGE ME

# NinjaVan has no settings table in the source, so it is env-only. Leave
# disabled until real credentials exist — an enabled courier with no keys
# fails at booking, after the customer has paid.
NINJAVAN_ENABLED=false
NINJAVAN_SANDBOX=false
NINJAVAN_COUNTRY=MY
NINJAVAN_CLIENT_ID=
NINJAVAN_CLIENT_SECRET=

# AWB labels: "a5" for office printers, "thermal" for 4x6in label stock.
AWB_LABEL_PAPER=a5

# --- Scheduled work -------------------------------------------------------
# Minutes an unpaid basket may sit untouched before it is released. Raising
# this holds stock off the shelf for longer; lowering it drops baskets while
# customers are still on the gateway's page.
CART_ABANDON_MINUTES=10

# J&T parcel tracking. Falls back to the key on the jt_setting row.
JT_TRACKING_URL=https://ylstandard.jtexpress.my/common/track/trackings
JT_TRACKING_COMPANY_ID=
JT_TRACKING_KEY=
TRACKING_BATCH=100

VITE_APP_NAME="${APP_NAME}"
